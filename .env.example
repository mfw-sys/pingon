# PingOn Docker Compose Environment Configuration
# Copy this file to .env before running: docker compose up -d

PINGON_PORT=8000
JWT_SECRET_KEY=change_this_to_a_long_random_secure_secret_key_here!
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
TZ=Asia/Jakarta
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=14
